)
)
# Plot --------------------------------------------------------------------
o %>%
ggplot() +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray") +
facet_grid(~model) +
geom_boxplot(aes(y = beta, color = type)) +
theme_minimal(17) +
theme(
axis.text.x = element_blank(),  # Remove x-axis ticks
axis.ticks.x = element_blank(), # Remove x-axis tick marks
