ci_cov = sum(0 > confint_lower & 0<confint_upper))
View(table)
write_csv(here('figures', "beta_table.csv"))
write_csv(here('figs', "beta_table.csv"))
write_csv(table, here('figs', "beta_table.csv"))
glimpse(table)
table <- table%>%
pivot_longer(cols = c(mean_beta, ci_cov), names_to = "metric", values_to = "value") %>%
pivot_wider(names_from = type, values_from = value)
View(table)
